###############################################################################
# EXPENSE TRACKER REST API - CURL REQUESTS COLLECTION
# 
# Usage:
# 1. Set environment variables (BASE_URL and TOKEN) in your terminal:
#    BASE_URL="http://localhost:8000"
#    TOKEN="YOUR_JWT_BEARER_TOKEN_HERE"
#
# 2. Or replace variables directly in the curl commands below.
###############################################################################

# =============================================================================
# 1. AUTHENTICATION ENDPOINTS (PUBLIC & PROTECTED)
# =============================================================================

# --- 1.1 Register New User ---
curl -X POST "http://localhost:8000/api/auth/register" \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Jane Doe",
    "email": "jane@example.com",
    "password": "password123",
    "image": "https://example.com/avatar.png"
  }'

# --- 1.2 Login User ---
curl -X POST "http://localhost:8000/api/auth/login" \
  -H "Content-Type: application/json" \
  -d '{
    "email": "demo@example.com",
    "password": "password123"
  }'

# --- 1.3 Get Current User Profile (Protected) ---
curl -X GET "http://localhost:8000/api/auth/me" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"


# =============================================================================
# 2. CATEGORY CRUD ENDPOINTS (PROTECTED)
# Supported fields:
# - name (string, required): e.g. "Food & Dining"
# - iconName (string, optional): e.g. "Utensils", "Wallet", "Zap", "Car", "Film", "ShoppingBag"
# - color (string, optional): "green", "blue", "purple", "amber", "rose", "cyan", "emerald", "indigo", "teal", "orange"
# - budget (number, optional): Monthly budget allocation (e.g. 600.00)
# =============================================================================

# --- 2.1 Get All Categories (Enriched with live spend, tx_count & budget stats) ---
curl -X GET "http://localhost:8000/api/categories" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 2.2 Create New Category (Full attributes) ---
curl -X POST "http://localhost:8000/api/categories" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Food & Dining",
    "iconName": "Utensils",
    "color": "green",
    "budget": 500.00
  }'

# --- 2.3 Create Another Category (Transport) ---
curl -X POST "http://localhost:8000/api/categories" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Transport & Fuel",
    "iconName": "Car",
    "color": "blue",
    "budget": 250.00
  }'

# --- 2.4 Get Single Category Details with Metrics ---
curl -X GET "http://localhost:8000/api/categories/CATEGORY_UUID_HERE" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 2.5 Update Category (Name, Color, and Budget) ---
curl -X PUT "http://localhost:8000/api/categories/CATEGORY_UUID_HERE" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json" \
  -d '{
    "name": "Fine Dining & Groceries",
    "iconName": "Utensils",
    "color": "amber",
    "budget": 650.00
  }'

# --- 2.6 Delete Category (Safe delete: blocked if transactions are linked) ---
curl -X DELETE "http://localhost:8000/api/categories/CATEGORY_UUID_HERE" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 2.7 Force Delete Category (Unlinks existing transactions and removes category) ---
curl -X DELETE "http://localhost:8000/api/categories/CATEGORY_UUID_HERE?force=true" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"


# =============================================================================
# 3. ACCOUNT CRUD ENDPOINTS (PROTECTED)
# Allowed type values:  "saveing_ac", "saving", "debit", "credit", "travel"
# Allowed title values: "bank_ac", "savings", "caredit card", "chash"
# =============================================================================

# --- 3.1 Get All Accounts ---
curl -X GET "http://localhost:8000/api/accounts" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 3.2 Create New Account ---
curl -X POST "http://localhost:8000/api/accounts" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json" \
  -d '{
    "type": "debit",
    "amount": 1500.50,
    "title": "bank_ac",
    "icons": "credit-card-icon"
  }'

# --- 3.3 Get Single Account Details ---
curl -X GET "http://localhost:8000/api/accounts/ACCOUNT_UUID_HERE" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 3.4 Update Account ---
curl -X PUT "http://localhost:8000/api/accounts/ACCOUNT_UUID_HERE" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json" \
  -d '{
    "type": "saving",
    "amount": 3200.00,
    "title": "savings",
    "icons": "wallet-icon-v2"
  }'

# --- 3.5 Delete Account ---
curl -X DELETE "http://localhost:8000/api/accounts/ACCOUNT_UUID_HERE" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"


# =============================================================================
# 4. TRANSACTION CRUD ENDPOINTS (PROTECTED)
# Allowed type values: "expense", "income"
# =============================================================================

# --- 4.1 Get All Transactions (With optional filters) ---
curl -X GET "http://localhost:8000/api/transactions?type=expense&search=grocery" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 4.2 Create New Transaction ---
curl -X POST "http://localhost:8000/api/transactions" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json" \
  -d '{
    "category_fk": "CATEGORY_UUID_HERE",
    "account_fk": "ACCOUNT_UUID_HERE",
    "description": "Supermarket Weekly Supplies",
    "account": "bank_ac",
    "date": "2026-08-22 14:30:00",
    "note": "Organic vegetables and fruits",
    "amount": 78.50,
    "type": "expense"
  }'

# --- 4.3 Get Single Transaction Details ---
curl -X GET "http://localhost:8000/api/transactions/TRANSACTION_UUID_HERE" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 4.4 Update Transaction ---
curl -X PUT "http://localhost:8000/api/transactions/TRANSACTION_UUID_HERE" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json" \
  -d '{
    "category_fk": "CATEGORY_UUID_HERE",
    "account_fk": "ACCOUNT_UUID_HERE",
    "description": "Supermarket Weekly Supplies - Updated",
    "account": "bank_ac",
    "date": "2026-08-22 15:00:00",
    "note": "Organic items and household essentials",
    "amount": 82.00,
    "type": "expense"
  }'

# --- 4.5 Delete Transaction ---
curl -X DELETE "http://localhost:8000/api/transactions/TRANSACTION_UUID_HERE" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"


# =============================================================================
# 5. DASHBOARD ENDPOINTS (MASTER & SECTION-WISE)
# =============================================================================

# --- 5.1 Full Master Dashboard (All sections in one call) ---
curl -X GET "http://localhost:8000/api/dashboard" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 5.1.1 Full Master Dashboard with custom month & limits ---
curl -X GET "http://localhost:8000/api/dashboard?month=2026-10&months=6&limit=5" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 5.2 Section 1: KPI Summary Cards (Total Balance, Monthly Income, Monthly Expenses) ---
curl -X GET "http://localhost:8000/api/dashboard/summary" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 5.2.1 Section 1 with specific target month ---
curl -X GET "http://localhost:8000/api/dashboard/summary?month=2026-10" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 5.3 Section 2: Spending Overview Chart (Monthly Income vs Expenses) ---
# Query params: months (default: 6, max: 24)
curl -X GET "http://localhost:8000/api/dashboard/spending-overview?months=6" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 5.4 Section 3: Expense Breakdown (Top spending categories & donut chart) ---
# Query params: month (default: current month, or 'all')
curl -X GET "http://localhost:8000/api/dashboard/expense-breakdown?month=2026-10" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 5.4.1 Section 3: Expense Breakdown All Time ---
curl -X GET "http://localhost:8000/api/dashboard/expense-breakdown?month=all" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 5.5 Section 4: Recent Transactions Table ---
# Query params: limit (default: 5, max: 50)
curl -X GET "http://localhost:8000/api/dashboard/recent-transactions?limit=5" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"


# =============================================================================
# 6. FINANCIAL PERFORMANCE & ANALYTICS (SCREENSHOT MATCH)
# 
# UI Elements Provided:
# 1. Header: Timeframe Dropdown (This Month, Last Month, Last 3 Months, This Year)
# 2. Top 4 Metric Cards:
#    - Total Income (e.g. ₹15,000.00 | +12.5% vs prior period)
#    - Total Expenses (e.g. ₹1,200.00 | -8.4% vs prior period)
#    - Net Savings (e.g. ₹13,800.00 | 92.0%)
#    - Savings Rate (e.g. 92.0%)
# 3. Spending Overview: Monthly Income vs Expenses Comparison Bar Chart
# 4. Expense Breakdown: Donut Chart Total & Top Categories List
# 5. Monthly Averages:
#    - Avg Monthly Income (e.g. ₹5,125.00 | ↑ 6.2% vs prior period)
#    - Avg Monthly Expenses (e.g. ₹3,410.50 | ↑ 3.8% vs prior period)
#    - Avg Monthly Savings (e.g. ₹1,714.50 | ↑ 9.4% vs prior period)
# =============================================================================

# --- 6.1 Complete Financial Performance (Default: This Month) ---
curl -X GET "http://localhost:8000/api/dashboard/financial-performance" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 6.2 Financial Performance - Filter: "This Month" ---
curl -X GET "http://localhost:8000/api/dashboard/financial-performance?timeframe=this_month" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 6.3 Financial Performance - Filter: "Last Month" ---
curl -X GET "http://localhost:8000/api/dashboard/financial-performance?timeframe=last_month" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 6.4 Financial Performance - Filter: "Last 3 Months" ---
curl -X GET "http://localhost:8000/api/dashboard/financial-performance?timeframe=last_3_months" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 6.5 Financial Performance - Filter: "This Year" ---
curl -X GET "http://localhost:8000/api/dashboard/financial-performance?timeframe=this_year" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 6.6 Financial Performance - Specific Target Month (YYYY-MM) ---
curl -X GET "http://localhost:8000/api/dashboard/financial-performance?month=2026-10" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 6.7 Financial Performance - Custom Date Range (Start & End Date) ---
curl -X GET "http://localhost:8000/api/dashboard/financial-performance?start_date=2026-08-01&end_date=2026-10-31" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 6.8 Direct Alias Route: GET /api/financial-performance ---
curl -X GET "http://localhost:8000/api/financial-performance?timeframe=this_month" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 6.9 Dedicated Monthly Averages Endpoint (Bottom Cards Row) ---
# Query params: months (default: 6)
curl -X GET "http://localhost:8000/api/dashboard/monthly-averages?months=6" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

# --- 6.10 Expense Breakdown with Timeframe Filter ---
curl -X GET "http://localhost:8000/api/dashboard/expense-breakdown?timeframe=this_month" \
  -H "Authorization: Bearer YOUR_JWT_BEARER_TOKEN_HERE" \
  -H "Content-Type: application/json"

