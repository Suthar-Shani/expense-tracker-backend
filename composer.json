{
    "name": "explane/explanse-backend",
    "description": "PHP REST API Backend for Expense Tracker with Auth and CRUD",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "php": ">=8.0",
        "firebase/php-jwt": "*",
        "mongodb/mongodb": "^2.4",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": true,
        "policy": {
            "advisories": {
                "ignore-id": ["PKSA-y2cr-5h3j-g3ys"]
            }
        }
    }
}
